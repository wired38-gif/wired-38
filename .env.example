# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_USERNAME and ADMIN_PASSWORD: Required for server-side admin login.
# Without these values the app intentionally disables login and blocks paid AI endpoints.
ADMIN_USERNAME="MY_ADMIN_USERNAME"
ADMIN_PASSWORD="MY_STRONG_ADMIN_PASSWORD"

# AUTH_SECRET: Optional but recommended. Used to sign admin session cookies.
# If omitted, ADMIN_PASSWORD is used as the signing secret.
AUTH_SECRET="MY_LONG_RANDOM_AUTH_SECRET"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
