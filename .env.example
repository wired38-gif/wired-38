# Required for Gemini AI responses
GEMINI_API_KEY=your-gemini-api-key

# Required — any random string, used to sign session cookies
AUTH_SECRET=random-secret-min-32-chars

# PIN to lock the Super Agent (recommended for public deployment)
SA_PIN=your-pin-here

# Optional: local Ollama for free local models
OLLAMA_URL=http://localhost:11434

# Optional: Apple Intelligence via apfel (macOS 26 + Apple Silicon)
# brew install apfel && apfel --serve --port 11435
APPLE_AI_URL=http://localhost:11435/v1
